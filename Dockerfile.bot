FROM python:3.12-slim

WORKDIR /app

# telegram_bot.py only needs an HTTP client, the Sheets client, and toml for
# the local secrets.toml fallback. Streamlit and friends are intentionally
# left out to keep the image small for the 256mb VM declared in fly.toml.
RUN pip install --no-cache-dir \
    requests==2.31.0 \
    gspread==5.12.4 \
    toml==0.10.2

COPY telegram_bot.py .

# Config comes from fly secrets: BOT_TOKEN, ADMIN_CHAT_IDS, SERVICE_ACCOUNT_JSON
CMD ["python", "-u", "telegram_bot.py"]